{
  "Profiles": {
    "Windows": {
      "Edge": {
        "AppName": "{title} (xCloud)",
        "Exe": "\"C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe\"",
        "WorkingDir": "C:/Program Files (x86)/Microsoft/Edge/Application",
        "Args": "--kiosk xbox.com/play/{storeId}"
      },
      "Edge (Cloud Preview)": {
        "AppName": "{title} (xCloud)",
        "Exe": "\"C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe\"",
        "WorkingDir": "C:/Program Files (x86)/Microsoft/Edge/Application",
        "Args": "--kiosk play.xbox.com/stream/{storeId}"
      }
    },
    "MacOS": {
      "Safari": {
        "AppName": "{title} (xCloud)",
        "Exe": "open",
        "WorkingDir": ".",
        "Args": "-a Safari xbox.com/play/{storeId}"
      },
      "Safari (Preview)": {
        "AppName": "{title} (xCloud)",
        "Exe": "open",
        "WorkingDir": ".",
        "Args": "-a Safari play.xbox.com/stream/{storeId}"
      }
    },
    "Linux": {
      "Edge": {
        "AppName": "{title} (xCloud)",
        "Exe": "\"{home}/kiosk.sh\"",
        "WorkingDir": "{home}/",
        "Args": "xbox.com/play/{storeId}"
      },
      "Edge (Cloud Preview)": {
        "AppName": "{title} (xCloud)",
        "Exe": "\"{home}/kiosk.sh\"",
        "WorkingDir": "{home}/",
        "Args": "play.xbox.com/{storeId}"
      }
    }
  }
}
